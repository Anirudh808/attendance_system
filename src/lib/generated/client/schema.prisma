generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

model Staff {
  id            String         @id
  name          String
  email         String         @unique
  password      String
  department    String
  role          Role           @default(STAFF)
  workLat       Float
  workLon       Float
  workAddress   String
  attendance    Attendance[]
  workLocations WorkLocation[]
}

model Attendance {
  id               String   @id
  staffId          String
  staffName        String
  timestamp        DateTime @default(now())
  currentLat       Float
  currentLon       Float
  accuracy         Float    @default(0.0)
  workLat          Float
  workLon          Float
  distanceFromWork Float
  status           String
  remarks          String
  staff            Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model WorkLocation {
  id      String @id @default(uuid())
  userId  String
  name    String
  workLat Float
  workLon Float
  staff   Staff  @relation(fields: [userId], references: [id], onDelete: Cascade)
}
