generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

model Staff {
  id            String         @id
  name          String
  email         String         @unique
  password      String
  department    String
  role          Role           @default(STAFF)
  attendance    Attendance[]
  workLocations WorkLocation[] @relation("StaffWorkLocations")
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

model Attendance {
  id               String         @id
  staffId          String
  staffName        String
  timestamp        DateTime       @default(now())
  currentLat       Float
  currentLon       Float
  accuracy         Float          @default(0.0)
  workLat          Float
  workLon          Float
  distanceFromWork Float
  status           String
  remarks          String
  attendanceType   AttendanceType @default(CHECK_IN)
  workLocationId   String?
  workLocationName String?
  staff            Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model WorkLocation {
  id      String  @id @default(uuid())
  name    String
  workLat Float
  workLon Float
  staff   Staff[] @relation("StaffWorkLocations")
}
